# Nothing is required. With no values Kin runs in demo mode: shared data stays
# on this device and the AI tier is the on-device rules (plus Gemini Nano where
# Chrome provides it).
#
# Fill these from the Firebase console (Project settings > Your apps > Web app)
# to turn on Cloud Firestore sync and Gemini through Firebase AI Logic.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. Defaults to gemini-3.5-flash.
VITE_GEMINI_MODEL=
