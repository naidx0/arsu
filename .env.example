# ARSU configuration. Copy to .env — the repo runs fully without it (SIM provider).

# Model provider: 'sim' (deterministic, offline) or 'gemini' (requires key).
# Auto-detects 'gemini' when GEMINI_API_KEY is set.
ARSU_PROVIDER=

# Gemini API — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase / Firestore plug path (production blackboard).
# When unset, ARSU uses the LocalBlackboard (data/blackboard.json).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server
ARSU_PORT=4780

# Flight data: 'seed' (default, offline-safe) or 'live' (airplanes.live
# ADS-B, falls back to seed when unreachable).
ARSU_FLIGHT_SOURCE=seed
